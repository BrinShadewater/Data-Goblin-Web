{
  "name": "data-goblin-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-meta.cjs && node scripts/indexnow-submit.cjs",
    "preview": "vite preview",
    "check:pagination": "node scripts/run-pagination-sanity.cjs",
    "check:contribute": "node scripts/check-contribute-mailto.cjs",
    "audit:images": "node scripts/audit-images.cjs",
    "archive:unused-art": "node scripts/archive-unused-art.cjs",
    "generate:responsive-art": "python scripts/generate-responsive-art.py",
    "check:budgets": "node scripts/check-performance-budgets.cjs",
    "check:built-site": "node scripts/check-built-site-smoke.cjs",
    "check:browser": "node scripts/check-browser-smoke.cjs",
    "verify": "node scripts/verify.cjs",
    "check:anchors": "node scripts/check-claim-anchors.cjs",
    "fix:fr": "node scripts/apply-fr-corrections.cjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
